# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Any long random text (40+ characters). Used to sign member and admin logins.
SESSION_SECRET=change-me-to-a-long-random-string

# Password for johnjanjani.com/admin
ADMIN_PASSWORD=choose-a-strong-password

# Your public site address
SITE_URL=https://johnjanjani.com

# Optional: email alerts for new members and showing requests (resend.com, free plan)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
